# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hospital_db

# ── Paths (override defaults from config.py if needed) ───────────────────────
# DATA_DIR=data
# MODELS_DIR=models

# ── API / External services ───────────────────────────────────────────────────
# API_KEY=your_api_key_here

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
