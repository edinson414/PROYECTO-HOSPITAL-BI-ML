                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    fecha_consulta AS FechaTiempo,
    DATEPART(YEAR, fecha_consulta) AS AñoTiempo,
    CASE 
        WHEN DATEPART(MONTH, fecha_consulta) BETWEEN 1 AND 6 THEN 1
        ELSE 2
    END AS SemestreTiempo,
    DATEPART(QUARTER, fecha_consulta) AS TrimestreTiempo,
    DATEPART(MONTH, fecha_consulta) AS MesTiempo,
    DATENAME(MONTH, fecha_consulta) AS NombreMesTiempo,
    DATEPART(DAY, fecha_consulta) AS DiaTiempo,
    DATENAME(WEEKDAY, fecha_consulta) AS DiaSemanaTiempo
FROM 
    Consultas</property>
