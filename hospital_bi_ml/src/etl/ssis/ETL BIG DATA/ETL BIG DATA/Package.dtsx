                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    dp.ID_paciente AS ID_pacienteConsulta,
    dm.ID_medico AS ID_medicoConsulta,
    dh.ID_historial AS ID_historialConsulta,
    dt.ID_tiempo AS ID_tiempoConsulta,
    dd.ID_diagnostico AS ID_DiagnosticoConsulta,
    dr.ID_receta AS ID_recetaConsulta,
    c.fecha_consulta AS FechaConsulta,
    c.motivo_consulta AS MotivoConsulta
FROM 
    Hospital.dbo.Consultas c
-- Relacionar con las tablas operativas en la base de datos `Hospital`
INNER JOIN Hospital.dbo.Pacientes pac ON pac.ID_paciente = c.ID_paciente_consulta
INNER JOIN Hospital.dbo.Medicos med ON med.ID_medico = c.ID_medico_consulta
INNER JOIN Hospital.dbo.Historial_Clinico hist ON hist.ID_historial = c.ID_historial_Consulta
INNER JOIN Hospital.dbo.Diagnosticos diag ON diag.ID_diagnostico = c.ID_Diagnostico_Consulta
INNER JOIN Hospital.dbo.Recetas rec ON rec.ID_receta = c.ID_receta_Consulta
-- Relacionar con las tablas del Data Mart `DW_Hospital`
INNER JOIN DW_Hospital.dbo.Dim_Pacientes dp ON dp.email_paciente = pac.email_paciente
INNER JOIN DW_Hospital.dbo.Dim_Medicos dm ON dm.email_medicos = med.email_medicos
INNER JOIN DW_Hospital.dbo.Dim_Historial_Clinico dh ON dh.resumen_historial = hist.resumen_historial
INNER JOIN DW_Hospital.dbo.Dim_Diagnosticos dd ON dd.descripción_diagnostico = diag.descripción_diagnostico
INNER JOIN DW_Hospital.dbo.Dim_Recetas dr ON dr.observaciones_receta = rec.observaciones_receta
INNER JOIN DW_Hospital.dbo.Dim_Tiempo dt ON dt.FechaTiempo = c.fecha_consulta</property>
